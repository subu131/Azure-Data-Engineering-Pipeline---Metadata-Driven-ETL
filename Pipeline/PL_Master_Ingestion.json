{
    "name": "PL_Master_Ingestion",
    "properties": {
        "activities": [
            {
                "name": "LKP_GetActiveConfigs",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": "SELECT \n       p.config_id,\n       source_type,\n       source_connection_name,\n       source_database,\n       source_schema,\n       source_table,\n       bronze_container,\n       bronze_path,\n       load_type,\n       watermark_column,\n       ISNULL(w.last_watermark_value, '1900-01-01') AS last_watermark_value\n   FROM pipeline_config p\n   LEFT JOIN watermark_values w ON p.config_id = w.config_id\n   WHERE p.is_active = 1\n   ORDER BY execution_order",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_MetadataConfig",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "FE_ProcessEachConfig",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "LKP_GetActiveConfigs",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('LKP_GetActiveConfigs').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "IF_CheckLoadType",
                            "type": "IfCondition",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@equals(item().load_type, 'FULL' )",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "CP_IncrementalLoad",
                                        "type": "Copy",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 3,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "AzureSqlSource",
                                                "sqlReaderQuery": {
                                                    "value": "@concat('SELECT * FROM ', item().source_schema, '.', item().source_table, \n           ' WHERE ', item().watermark_column, ' > ''', \n           item().last_watermark_value, '''')",
                                                    "type": "Expression"
                                                },
                                                "queryTimeout": "02:00:00",
                                                "partitionOption": "None"
                                            },
                                            "sink": {
                                                "type": "ParquetSink",
                                                "storeSettings": {
                                                    "type": "AzureBlobFSWriteSettings"
                                                },
                                                "formatSettings": {
                                                    "type": "ParquetWriteSettings"
                                                }
                                            },
                                            "enableStaging": false,
                                            "translator": {
                                                "type": "TabularTranslator",
                                                "typeConversion": true,
                                                "typeConversionSettings": {
                                                    "allowDataTruncation": true,
                                                    "treatBooleanAsNumber": false
                                                }
                                            }
                                        },
                                        "inputs": [
                                            {
                                                "referenceName": "DS_SourceSQLTable",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "DatabaseName": "@item().source_database",
                                                    "SchemaName": "@item().source_schema",
                                                    "TableName": "@item().source_table"
                                                }
                                            }
                                        ],
                                        "outputs": [
                                            {
                                                "referenceName": "DS_LakeWriteParquet",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Container": "@item().bronze_container",
                                                    "Directory": "@concat(item().bronze_path, formatDateTime(utcNow(), 'yyyy/MM/dd'))",
                                                    "FileName": "-"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "name": "Stored procedure2",
                                        "type": "SqlServerStoredProcedure",
                                        "dependsOn": [
                                            {
                                                "activity": "CP_IncrementalLoad",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 3,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "storedProcedureName": "[dbo].[sp_update_watermark]",
                                            "storedProcedureParameters": {
                                                "config_id": {
                                                    "value": {
                                                        "value": "@item().config_id",
                                                        "type": "Expression"
                                                    },
                                                    "type": "Int32"
                                                },
                                                "new_watermark_value": {
                                                    "value": {
                                                        "value": "@utcNow()",
                                                        "type": "Expression"
                                                    },
                                                    "type": "DateTime"
                                                },
                                                "records_processed": {
                                                    "value": {
                                                        "value": "@activity('CP_IncrementalLoad').output.rowsCopied",
                                                        "type": "Expression"
                                                    },
                                                    "type": "Int32"
                                                }
                                            }
                                        },
                                        "linkedServiceName": {
                                            "referenceName": "LS_MetadataDB",
                                            "type": "LinkedServiceReference"
                                        }
                                    }
                                ],
                                "ifTrueActivities": [
                                    {
                                        "name": "CP_FullLoad",
                                        "type": "Copy",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 3,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "AzureSqlSource",
                                                "queryTimeout": "02:00:00",
                                                "partitionOption": "None"
                                            },
                                            "sink": {
                                                "type": "ParquetSink",
                                                "storeSettings": {
                                                    "type": "AzureBlobFSWriteSettings"
                                                },
                                                "formatSettings": {
                                                    "type": "ParquetWriteSettings"
                                                }
                                            },
                                            "enableStaging": false,
                                            "translator": {
                                                "type": "TabularTranslator",
                                                "typeConversion": true,
                                                "typeConversionSettings": {
                                                    "allowDataTruncation": true,
                                                    "treatBooleanAsNumber": false
                                                }
                                            }
                                        },
                                        "inputs": [
                                            {
                                                "referenceName": "DS_SourceSQLTable",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "DatabaseName": {
                                                        "value": "@item().source_database",
                                                        "type": "Expression"
                                                    },
                                                    "SchemaName": "@item().source_schema",
                                                    "TableName": "@item().source_table"
                                                }
                                            }
                                        ],
                                        "outputs": [
                                            {
                                                "referenceName": "DS_LakeWriteParquet",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Container": "@item().bronze_container",
                                                    "Directory": "@concat(item().bronze_path, formatDateTime(utcNow(), 'yyyy/MM/dd'))",
                                                    "FileName": "-"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "name": "Stored procedure1",
                                        "type": "SqlServerStoredProcedure",
                                        "dependsOn": [
                                            {
                                                "activity": "CP_FullLoad",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 3,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "storedProcedureName": "[dbo].[sp_update_watermark]",
                                            "storedProcedureParameters": {
                                                "config_id": {
                                                    "value": {
                                                        "value": "@item().config_id",
                                                        "type": "Expression"
                                                    },
                                                    "type": "Int32"
                                                },
                                                "new_watermark_value": {
                                                    "value": {
                                                        "value": "@utcnow()",
                                                        "type": "Expression"
                                                    },
                                                    "type": "DateTime"
                                                },
                                                "records_processed": {
                                                    "value": {
                                                        "value": "@activity('CP_FullLoad').output.rowsCopied",
                                                        "type": "Expression"
                                                    },
                                                    "type": "Int32"
                                                }
                                            }
                                        },
                                        "linkedServiceName": {
                                            "referenceName": "LS_AzureSqlDB",
                                            "type": "LinkedServiceReference",
                                            "parameters": {
                                                "DBName": "MetadataDB"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "annotations": [],
        "lastPublishTime": "2026-03-01T04:42:08Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
